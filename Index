const ENDINGS={
  A:{title:'대국민 결혼 발표',tag:'진엔딩 · 재앙 지수 7 이상',hint:''},
  B:{title:'일주일만 시간을',tag:'보류 엔딩 · 재앙 지수 4~6',hint:''},
  C:{title:'목적지: 부시장실',tag:'평화 엔딩 · 재앙 지수 3 이하',hint:''}
};
const MAXCHAOS=10;

/* ---------- Engine ---------- */
const $=id=>document.getElementById(id);
const stage=$('stage'),textEl=$('text'),nameEl=$('name'),nextEl=$('next'),castEl=$('cast'),bigEl=$('big'),choicesEl=$('choices');
const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
let st={scene:'start',idx:0,chaos:0,flags:{},show:[],bg:'bed',playing:false};
let typing=null,fullText='',busy=false;

function loadFound(){try{return JSON.parse(localStorage.getItem('yj-ep1-endings')||'[]')}catch(e){return[]}}
function saveFound(arr){try{localStorage.setItem('yj-ep1-endings',JSON.stringify(arr))}catch(e){}}

for(let i=0;i<MAXCHAOS;i++){$('cells').appendChild(document.createElement('i'))}
function drawMeter(delta){
  [...$('cells').children].forEach((c,i)=>{c.classList.toggle('on',i<st.chaos);c.classList.toggle('hot',i<st.chaos&&st.chaos>=7)});
  $('num').textContent=st.chaos;
  if(delta>0){const f=document.createElement('div');f.className='float';f.textContent='+'+delta+' 재앙';$('meter').appendChild(f);setTimeout(()=>f.remove(),1200)}
}
function setBg(b){st.bg=b;$('bg').className='bg bg-'+b;$('props').innerHTML=PROPS[b]||''}
function setShow(list){
  const prev=st.show;st.show=list;castEl.innerHTML='';
  castEl.classList.toggle('trio',list.length>2);
  list.forEach(k=>{const d=document.createElement('div');d.className='char'+(prev.includes(k)?'':' enter');d.dataset.k=k;d.innerHTML=CHARS[k];castEl.appendChild(d)});
}
function highlight(speaker){
  [...castEl.children].forEach(d=>{const k=d.dataset.k;d.classList.toggle('talk',k===speaker);d.classList.toggle('dim',!!speaker&&k!==speaker)});
}
function fx(name){
  stage.classList.remove('shake','bounce','flash');void stage.offsetWidth;
  bigEl.hidden=true;bigEl.classList.remove('ring');
  if(name==='shake'||name==='bounce'||name==='flash')stage.classList.add(name);
  if(name==='clock'){bigEl.textContent='AM 11:47';bigEl.hidden=false}
  if(name==='clock2'){bigEl.textContent='PM 12:52';bigEl.hidden=false}
  if(name==='caller'){bigEl.textContent='전 남편';bigEl.classList.add('ring');bigEl.hidden=false}
}
function type(str){
  fullText=str;clearInterval(typing);nextEl.hidden=true;
  if(reduce){textEl.textContent=str;nextEl.hidden=false;typing=null;return}
  let i=0;textEl.textContent='';
  typing=setInterval(()=>{i++;textEl.textContent=str.slice(0,i);if(i>=str.length){clearInterval(typing);typing=null;nextEl.hidden=false}},26);
}
function goto(id){
  if(id==='ending')id=st.chaos>=7?'endA':st.chaos>=4?'endB':'endC';
  st.scene=id;st.idx=0;run();
}
function run(){
  const line=S[st.scene][st.idx];
  if(!line)return;
  if(line.when&&!line.when(st.flags)){st.idx++;return run()}
  if(line.bg)setBg(line.bg);
  if(line.show)setShow(line.show);
  if(line.go)return goto(line.go);
  if(line.end)return showEnding(line.end);
  if(line.choice)return showChoices(line.choice);
  fx(line.fx);
  if(line.s){
    nameEl.hidden=false;nameEl.textContent=NAMES[line.s];nameEl.style.background=NAMECOLOR[line.s];
    textEl.classList.remove('narr');highlight(line.s);type(line.t);
  }else{
    nameEl.hidden=true;textEl.classList.add('narr');highlight(null);type(line.n);
  }
}
function advance(){
  if(!st.playing||busy||!choicesEl.hidden)return;
  if(typing){clearInterval(typing);typing=null;textEl.textContent=fullText;nextEl.hidden=false;return}
  st.idx++;run();
}
function showChoices(list){
  nextEl.hidden=true;choicesEl.innerHTML='<h3>어떻게 할까?</h3>';
  list.forEach(o=>{
    const b=document.createElement('button');b.className='choice';
    b.innerHTML=`<span>${o.t}</span>${o.c>0?`<small>재앙 +${o.c}</small>`:''}`;
    b.onclick=e=>{e.stopPropagation();choicesEl.hidden=true;
      if(o.set)Object.assign(st.flags,o.set);
      if(o.c){st.chaos=Math.min(MAXCHAOS,st.chaos+o.c);drawMeter(o.c)}
      goto(o.go)};
    choicesEl.appendChild(b);
  });
  choicesEl.hidden=false;
  const first=choicesEl.querySelector('.choice');if(first)first.focus();
}
function collectHTML(found){
  return Object.entries(ENDINGS).map(([k,v])=>found.includes(k)?`<span>${v.title}</span>`:`<span class="locked">??? 잠김</span>`).join('');
}
function showEnding(k){
  st.playing=false;
  const found=loadFound();if(!found.includes(k)){found.push(k);saveFound(found)}
  const e=ENDINGS[k];
  $('endTitle').textContent=e.title;
  $('endTag').textContent=e.tag+' · 최종 재앙 지수 '+st.chaos;
  $('endCollect').innerHTML=collectHTML(found);
  const missing=Object.keys(ENDINGS).filter(x=>!found.includes(x));
  $('endHint').textContent=missing.length?`엔딩 ${found.length}/3 수집. `+(missing.includes('A')?'재앙 지수를 끝까지 올리면 진엔딩이 열립니다.':missing.includes('C')?'얌전하게 굴면 전혀 다른 결말이 나옵니다.':'적당히만 사고를 쳐 보세요.'):'모든 엔딩을 모았습니다! 2화를 기다려 주세요.';
  $('end').hidden=false;$('againBtn').focus();
}
function start(){
  st={scene:'start',idx:0,chaos:0,flags:{},show:[],bg:'bed',playing:true};
  $('title').hidden=true;$('end').hidden=true;choicesEl.hidden=true;castEl.innerHTML='';
  drawMeter(0);run();stage.focus();
}
function renderTitle(){$('titleCollect').innerHTML=loadFound().length?collectHTML(loadFound()):''}

stage.addEventListener('click',e=>{if(e.target.closest('.overlay,.choices'))return;advance()});
document.addEventListener('keydown',e=>{
  if((e.key===' '||e.key==='Enter')&&st.playing&&choicesEl.hidden&&!e.target.closest('button')){e.preventDefault();advance()}
});
$('startBtn').onclick=e=>{e.stopPropagation();start()};
$('againBtn').onclick=e=>{e.stopPropagation();start()};

setBg('bed');drawMeter(0);renderTitle();
</script>

