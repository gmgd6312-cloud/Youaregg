<style>
/* Layout: one-screen visual novel — HUD strip, comic-panel stage, dialogue box pinned inside the panel */
:root{
  --ink:#1d1b3a;
  --ink-deep:#14122a;
  --paper:#ffffff;
  --pop:#ff4f8b;
  --sun:#ffd23f;
  --sky:#9ad7ff;
  --muted:#6b6890;
  --display:"Black Han Sans","Apple SD Gothic Neo","Malgun Gothic",sans-serif;
  --body:"Gowun Dodum","Apple SD Gothic Neo","Malgun Gothic",sans-serif;
  color-scheme:light;
}
html,body{height:100%}
body{background:var(--ink-deep);color:var(--ink);font-family:var(--body);overflow:hidden}
.app{height:100%;max-width:780px;margin:0 auto;display:flex;flex-direction:column;gap:10px;
  padding-block:12px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));box-sizing:border-box}

/* HUD */
.hud{display:flex;align-items:center;justify-content:space-between;gap:12px;color:var(--paper);flex-wrap:wrap}
.ep{font-family:var(--display);font-size:15px;letter-spacing:.02em;display:flex;align-items:center;gap:8px;min-width:0}
.ep b{background:var(--sun);color:var(--ink);padding:2px 8px;border-radius:4px;font-weight:400}
.ep span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.meter{display:flex;align-items:center;gap:8px;position:relative}
.meter label{font-family:var(--display);font-size:13px;letter-spacing:.06em;color:var(--sun)}
.cells{display:flex;gap:3px}
.cells i{width:12px;height:16px;border-radius:2px;background:#ffffff22;transition:background .3s}
.cells i.on{background:var(--pop)}
.cells i.on.hot{background:var(--sun)}
.meter .num{font-family:var(--display);font-size:15px;font-variant-numeric:tabular-nums;min-width:2.2em;text-align:right}
.float{position:absolute;right:0;top:-6px;font-family:var(--display);color:var(--pop);font-size:16px;pointer-events:none;animation:rise 1.1s ease-out forwards}
@keyframes rise{from{opacity:1;transform:translateY(0)}to{opacity:0;transform:translateY(-26px)}}

/* Stage */
.stage{position:relative;flex:1;min-height:0;border:3px solid var(--paper);border-radius:14px;overflow:hidden;cursor:pointer;user-select:none;-webkit-user-select:none;background:var(--sky)}
.bg{position:absolute;inset:0;transition:background .5s}
.props{position:absolute;inset:0;pointer-events:none}
.props svg{width:100%;height:100%;display:block}
.bg-bed{background:linear-gradient(#ffd6e4,#c9e4ff)}
.bg-kitchen{background:repeating-linear-gradient(0deg,#bff0dc 0 38px,#a9e6cd 38px 40px),#bff0dc}
.bg-door{background:linear-gradient(#c6b8ff,#9f8cf0)}
.bg-phone{background:radial-gradient(circle at 50% 35%,#4a3c9c,#15132b 70%)}
.bg-hall{background:linear-gradient(#e3e9f3,#c3cddd)}
.bg-press{background:linear-gradient(#e3e9f3,#c3cddd)}

.cast{position:absolute;left:0;right:0;bottom:96px;height:62%;display:flex;justify-content:center;align-items:flex-end;gap:2%;pointer-events:none}
.char{height:100%;max-width:34%;transition:filter .25s,transform .25s,opacity .3s;transform-origin:bottom center}
.char svg{height:100%;width:auto;max-width:100%;display:block;filter:drop-shadow(0 4px 0 rgba(29,27,58,.25))}
.cast.trio .char{height:84%}
.char.dim{filter:brightness(.62) saturate(.7)}
.char.talk{transform:translateY(-6px)}
.char.enter{animation:pop .35s ease-out}
@keyframes pop{from{opacity:0;transform:translateY(20px) scale(.96)}to{opacity:1}}
.stage.shake .cast,.stage.shake .box{animation:shake .38s}
@keyframes shake{0%,100%{transform:translateX(0)}20%{transform:translateX(-7px)}40%{transform:translateX(6px)}60%{transform:translateX(-4px)}80%{transform:translateX(3px)}}
.stage.bounce .char.talk{animation:hop .45s}
@keyframes hop{0%,100%{transform:translateY(-6px)}40%{transform:translateY(-22px)}}
.stage.flash::after{content:"";position:absolute;inset:0;background:#fff;animation:flash 1.2s steps(1) 1;pointer-events:none}
@keyframes flash{0%{opacity:.95}12%{opacity:0}24%{opacity:.85}36%{opacity:0}52%{opacity:.7}64%,100%{opacity:0}}

.big{position:absolute;left:50%;top:30%;transform:translate(-50%,-50%);font-family:var(--display);color:var(--ink);background:var(--paper);border:3px solid var(--ink);border-radius:12px;padding:10px 18px;font-size:clamp(28px,7vw,52px);font-variant-numeric:tabular-nums;box-shadow:5px 5px 0 var(--ink);white-space:nowrap;pointer-events:none}
.big.ring{background:var(--pop);color:var(--paper);animation:ring .5s infinite}
@keyframes ring{0%,100%{transform:translate(-50%,-50%) rotate(-3deg)}50%{transform:translate(-50%,-50%) rotate(3deg)}}

/* Dialogue */
.box{position:absolute;left:12px;right:12px;bottom:12px;background:var(--paper);border:3px solid var(--ink);border-radius:12px;box-shadow:5px 5px 0 var(--ink);padding:18px 18px 14px;min-height:78px}
.name{position:absolute;top:-17px;left:14px;font-family:var(--display);font-size:16px;padding:3px 12px;border-radius:6px;border:3px solid var(--ink);background:var(--sun);color:var(--ink)}
.name[hidden]{display:none!important}
.text{font-size:clamp(16px,2.4vw,19px);line-height:1.6;word-break:keep-all;min-height:3.2em}
.text.narr{color:var(--muted);font-style:normal}
.next{position:absolute;right:14px;bottom:8px;font-size:12px;color:var(--pop);animation:blink 1s infinite}
@keyframes blink{50%{opacity:.2}}

.choices{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:12px;background:rgba(20,18,42,.55);padding:16px;cursor:default}
.choices h3{margin:0 0 4px;font-family:var(--display);font-weight:400;color:var(--sun);font-size:18px;letter-spacing:.04em}
.choice{width:min(440px,100%);font:inherit;font-size:17px;text-align:left;background:var(--paper);color:var(--ink);border:3px solid var(--ink);border-radius:10px;padding:12px 16px;box-shadow:4px 4px 0 var(--ink);cursor:pointer;display:flex;justify-content:space-between;gap:10px;align-items:center;transition:transform .12s,box-shadow .12s}
.choice:hover,.choice:focus-visible{transform:translate(-2px,-2px);box-shadow:6px 6px 0 var(--pop);outline:none}
.choice small{font-family:var(--display);font-size:12px;color:var(--pop);white-space:nowrap}

/* Title & ending overlays */
.overlay{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;gap:14px;padding:20px;cursor:default;overflow:auto}
.title-screen{background:radial-gradient(circle at 50% 40%,#ff7aa8,#ff4f8b 45%,#c2306a)}
.title-screen .badge{font-family:var(--display);background:var(--ink);color:var(--sun);padding:4px 14px;border-radius:6px;font-size:16px}
.title-screen h1{margin:0;font-family:var(--display);font-weight:400;color:var(--paper);font-size:clamp(34px,8vw,64px);line-height:1.1;text-wrap:balance;text-shadow:4px 4px 0 var(--ink);word-break:keep-all}
.title-screen p{margin:0;color:var(--paper);font-size:16px;max-width:30em;word-break:keep-all}
.btn{font-family:var(--display);font-size:20px;background:var(--sun);color:var(--ink);border:3px solid var(--ink);border-radius:10px;padding:10px 28px;box-shadow:4px 4px 0 var(--ink);cursor:pointer;transition:transform .12s,box-shadow .12s}
.btn:hover,.btn:focus-visible{transform:translate(-2px,-2px);box-shadow:6px 6px 0 var(--ink);outline:none}
.btn.ghost{background:var(--paper);font-size:16px;padding:8px 18px}
.collect{display:flex;gap:8px;flex-wrap:wrap;justify-content:center}
.collect span{font-size:13px;padding:4px 10px;border-radius:999px;border:2px solid var(--ink);background:var(--paper);color:var(--ink)}
.collect span.locked{background:transparent;color:var(--ink);opacity:.55;border-style:dashed}
.end-screen{background:rgba(20,18,42,.88);color:var(--paper)}
.end-screen .fin{font-family:var(--display);color:var(--sun);font-size:16px;letter-spacing:.1em}
.end-screen h2{margin:0;font-family:var(--display);font-weight:400;font-size:clamp(28px,6vw,44px);text-wrap:balance;word-break:keep-all}
.end-screen .tag{font-size:14px;color:#c9c6e8}
.end-screen .collect span{border-color:var(--paper)}
.end-screen .collect span.locked{color:var(--paper)}
.teaser{background:var(--pop);color:var(--paper);border:3px solid var(--paper);border-radius:10px;padding:10px 18px;font-family:var(--display);font-size:clamp(17px,3.6vw,22px);transform:rotate(-2deg);box-shadow:4px 4px 0 #000}
.teaser small{display:block;font-family:var(--body);font-size:12px;opacity:.9;margin-bottom:2px}
.hint{font-size:13px;color:#c9c6e8;max-width:28em;word-break:keep-all}
.row{display:flex;gap:10px;flex-wrap:wrap;justify-content:center}

@media (max-width:480px){
  .cast{bottom:110px;height:52%}
  .box{padding:16px 14px 14px}
  .cells i{width:9px;height:14px}
}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation:none!important;transition:none!important}
}
</style>

<div class="app">
  <div class="hud">
    <div class="ep"><b>1화</b><span>윤정의 탄생은 재앙이었다</span></div>
